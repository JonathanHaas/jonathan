// Cloudflare Workers config for jonathan.jawnhaas.xyz.
// "name" must match the Worker's name in the Cloudflare dashboard.
// A Pages project skips this file (it has no pages_build_output_dir).
{
  "name": "jonathan",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // Run the Worker on every request so it can answer agents in Markdown.
    "run_worker_first": true,
    // Unknown paths return 404.html with a 404 status (instead of an empty 404).
    "not_found_handling": "404-page"
  }
}
