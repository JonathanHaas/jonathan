<a class="skip" href="#main">{% if lang == "es" %}Saltar al contenido principal{% elif lang == "zh" %}跳转到主要内容{% else %}Skip to main content{% endif %}</a>
<header class="top">
  <p class="mark"><a href="{% if lang == 'es' %}/es/{% elif lang == 'zh' %}/zh/{% else %}/{% endif %}">L. Jonathan Haas</a></p>
  <nav aria-label="{% if lang == 'es' %}Primaria{% elif lang == 'zh' %}主导航{% else %}Primary{% endif %}">
    <a href="{% if lang == 'es' %}/es/{% elif lang == 'zh' %}/zh/{% else %}/{% endif %}"{% if page.url == '/' or page.url == '/es/' or page.url == '/zh/' %} aria-current="page"{% endif %}>{% if lang == "es" %}Inicio{% elif lang == "zh" %}首页{% else %}Home{% endif %}</a>
    <a href="/now/"{% if page.url == '/now/' %} aria-current="page"{% endif %}>Now</a>
    <a href="/L-Jonathan-Haas-CV.pdf" download="L-Jonathan-Haas-CV.pdf">CV</a>
  </nav>
  <button class="theme-toggle" id="theme-toggle" aria-label="Switch to dark mode" aria-pressed="false">
    <svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
    <svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
  </button>
  <nav class="lang-switch" aria-label="Language / Idioma / 语言">
    {% set enUrl = alternateBase if alternateBase else '/' %}
    {% set esUrl = ('/es' + alternateBase) if alternateBase else '/es/' %}
    {% set zhUrl = ('/zh' + alternateBase) if alternateBase else '/zh/' %}
    <a href="{{ enUrl }}" hreflang="en" {% if lang == "en" %}aria-current="true"{% endif %}>EN</a>
    <a href="{{ esUrl }}" hreflang="es" {% if lang == "es" %}aria-current="true"{% endif %}>ES</a>
    <a href="{{ zhUrl }}" hreflang="zh-Hans" {% if lang == "zh" %}aria-current="true"{% endif %}>中文</a>
  </nav>
</header>
